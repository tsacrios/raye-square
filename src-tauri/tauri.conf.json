{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "console-windows",
  "version": "0.1.0",
  "identifier": "com.tsacr.console-windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "console-windows",
        "width": 1280,
        "height": 720,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tsacrios/raye-square/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRjZFNEZGRTNGMEE2NEYKUldSUHB2RGovK1QyemoyWjJXY0g3RHAwQUgxcWVSaG95YXlYOGdLanl0eVA4QlVjOSt4bUVwaEEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
